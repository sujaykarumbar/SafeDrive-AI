# SafeDrive AI Configuration

# Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="SafeDrive AI — Smart Driver Safety & Road Hazard Intelligence"
API_PREFIX=/api/v1
SECRET_KEY=safedrive-super-secret-development-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for effortless zero-config local run
DATABASE_URL=sqlite:///./safedrive.db
# PostgreSQL / PostGIS (Docker / Production):
# DATABASE_URL=postgresql://safedrive_user:safedrive_pass@localhost:5432/safedrive_db

# Redis (Optional in local dev, in-memory fallback enabled)
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=./uploads
STATIC_DIR=./static

# Google Maps Platform Configuration
# Server-side API key: Enable Routes API, Places API, Geocoding API
# Restrict this key by IP address / server environment
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key_here
# Client-side API key: Enable Maps SDK for Android & Maps JavaScript API
# Restrict by Android package name (com.safedrive.ai.safedrive_app) + SHA-1 fingerprint
GOOGLE_MAPS_CLIENT_API_KEY=your_google_maps_client_api_key_here
ENABLE_GOOGLE_MAPS=True

# Simulation & Telemetry Settings
DEFAULT_LOCATION_INTERVAL_SECONDS=2
HARSH_BRAKE_G_THRESHOLD_CAR=0.45
HARSH_ACCEL_G_THRESHOLD_CAR=0.40
MAX_SPEED_KMPH_CAR=100.0

# Server ports
BACKEND_PORT=8000
CARETAKER_WEB_PORT=5173
DEPARTMENT_WEB_PORT=5174
ADMIN_WEB_PORT=5175
